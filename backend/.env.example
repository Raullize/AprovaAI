# ── Backend Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://user:password@localhost:5433/aprovaai"

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Authentication (JWT) ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars

# ── Upload / Storage ─────────────────────────────────────────────────────────
# Local directory for storing uploaded images. Default: ./uploads
UPLOAD_DIR=./uploads

# ── Inteligência Artificial (Prof. Sabichão) ─────────────────────────────────
# Chave do Google AI Studio (Gemini). Mantenha apenas no backend.
# Sem a chave, o chat roda em modo de demonstração (FakeLlmProvider).
GEMINI_API_KEY=
# Modelo barato do free tier. Ajuste conforme a disponibilidade na sua conta.
GEMINI_MODEL=gemini-3.5-flash-lite
# gemini | fake (fake = respostas de demonstração, usado em testes)
AI_PROVIDER=gemini
AI_MAX_OUTPUT_TOKENS=500
