# ── Backend Environment Variables (Testes Funcionais E2E) ────────────────────
# Copy this file to .env.test and fill in the values.
#   cp .env.test.example .env.test
#
# IMPORTANTE: Este arquivo deve permanecer na RAIZ do backend (backend/.env.test)
# pois tanto o testHelper.ts quanto o Prisma CLI carregam variáveis a partir de
# process.cwd() = diretório onde o `pnpm test:func` é executado.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (ambiente de TESTE ISOLADO) ─────────────────────────────────────
# PostgreSQL de teste (porta 5434) — docker-compose.test.yml service db_test
# NÃO usar a porta 5433 (reservada para desenvolvimento).
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/aprovaai_test"

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=test
PORT=3001

# ── Authentication (JWT) ─────────────────────────────────────────────────────
# DEVE ser a MESMA chave usada no backend que está rodando em paralelo (backend/.env)
# pois os tokens JWT gerados durante o /auth/login são validados com a mesma secret
# pelo JwtAuthGuard. Se for diferente, todos os testes protegidos retornam 401.
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars

# ── Upload / Storage ─────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── Test Runner (usado pelo supertest via testHelper.ts) ─────────────────────
# URL base onde a API NestJS está rodando (terminal separado com pnpm start:dev)
# Por padrão assume a mesma porta declarada na variável PORT acima.
APPLICATION_BASE_URL=http://localhost:3001
