generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}

enum SubscriptionPlan {
  FREE
  PREMIUM

  @@map("subscription_plan")
}

model User {
  id               String           @id @default(uuid()) @map("id")
  fullName         String           @map("full_name")
  username         String           @unique @map("username")
  dateOfBirth      DateTime         @map("date_of_birth")
  email            String           @unique @map("email")
  passwordHash     String           @map("password_hash")
  subscriptionPlan SubscriptionPlan @default(FREE) @map("subscription_plan")
  role             UserRole         @default(USER) @map("role")
  xp               Int              @default(0) @map("xp")
  streakCount      Int              @default(0) @map("streak_count")
  lastActiveAt     DateTime?        @map("last_active_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  examResults    ExamResult[]
  userActivities UserActivity[]

  @@map("users")
}

enum ExamStatus {
  ACTIVE
  INACTIVE

  @@map("exam_status")
}

enum TopicStatus {
  ACTIVE
  INACTIVE

  @@map("topic_status")
}

enum ExamCategory {
  CONCURSOS
  CERTIFICACOES
  VESTIBULAR
  OAB
  OUTROS

  @@map("exam_category")
}

model Exam {
  id          String       @id @default(uuid()) @map("id")
  name        String       @map("name")
  slug        String       @unique @map("slug")
  description String?      @map("description")
  status      ExamStatus   @default(ACTIVE) @map("status")
  order       Int          @default(0) @map("order")
  iconKey     String?      @map("icon_key")
  colorScheme String?      @map("color_scheme")
  category    ExamCategory @default(OUTROS) @map("category")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  topics Topic[]

  @@map("exams")
}

model Topic {
  id          String      @id @default(uuid()) @map("id")
  name        String      @map("name")
  slug        String      @map("slug")
  description String?     @map("description")
  status      TopicStatus @default(ACTIVE) @map("status")
  order       Int         @default(0) @map("order")
  examId      String      @map("exam_id")
  iconKey     String?     @map("icon_key")
  colorScheme String?     @map("color_scheme")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  exam   Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  levels Level[]

  @@unique([examId, slug])
  @@map("topics")
}

enum LevelStatus {
  ACTIVE
  INACTIVE

  @@map("level_status")
}

model Level {
  id                String      @id @default(uuid()) @map("id")
  name              String      @map("name")
  slug              String      @map("slug")
  description       String?     @map("description")
  order             Int         @map("order")
  topicId           String      @map("topic_id")
  status            LevelStatus @default(ACTIVE) @map("status")
  xpReward          Int         @default(0) @map("xp_reward")
  passingPercentage Float          @default(70.0) @map("passing_percentage")
  timeLimit         Int?           @map("time_limit")
  simulationMode    SimulationMode @default(PRACTICE) @map("simulation_mode")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  topic       Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions   Question[]
  examResults ExamResult[]

  @@unique([topicId, slug])
  @@map("levels")
}

enum QuestionType {
  MULTIPLE_CHOICE
  SINGLE_CHOICE
  
  @@map("question_type")
}

enum QuestionStatus {
  ACTIVE
  INACTIVE

  @@map("question_status")
}

model Question {
  id          String         @id @default(uuid()) @map("id")
  content     String         @map("content")
  imageUrl    String?        @map("image_url")
  type        QuestionType   @default(MULTIPLE_CHOICE) @map("type")
  status      QuestionStatus @default(ACTIVE) @map("status")
  order       Int            @map("order")
  explanation String?        @map("explanation")
  studyLink   String?        @map("study_link")
  levelId     String         @map("level_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  level   Level        @relation(fields: [levelId], references: [id], onDelete: Cascade)
  options Option[]
  answers ExamAnswer[]

  @@map("questions")
}

model Option {
  id         String   @id @default(uuid()) @map("id")
  text       String   @map("text")
  isCorrect  Boolean  @default(false) @map("is_correct")
  order      Int      @map("order")
  questionId String   @map("question_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("options")
}

enum SimulationStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED

  @@map("simulation_status")
}

enum SimulationMode {
  PRACTICE
  EXAM

  @@map("simulation_mode")
}

model ExamResult {
  id             String           @id @default(uuid()) @map("id")
  userId         String           @map("user_id")
  levelId        String           @map("level_id")
  status         SimulationStatus @default(IN_PROGRESS) @map("status")
  mode           SimulationMode   @default(PRACTICE) @map("mode")
  score          Int?             @map("score")
  totalQuestions Int              @map("total_questions")
  percentage     Float?           @map("percentage")
  passed         Boolean?         @map("passed")
  stars          Int?             @map("stars")
  timeSpent      Int?             @map("time_spent")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  level   Level        @relation(fields: [levelId], references: [id], onDelete: Cascade)
  answers ExamAnswer[]

  @@map("exam_results")
}

model ExamAnswer {
  id               String   @id @default(uuid()) @map("id")
  examResultId     String   @map("exam_result_id")
  questionId       String   @map("question_id")
  selectedOptions  String[] @map("selected_options")
  isCorrect        Boolean? @map("is_correct")
  timeSpent        Int?     @map("time_spent")
  isFlaggedForReview Boolean @default(false) @map("is_flagged_for_review")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  examResult ExamResult @relation(fields: [examResultId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([examResultId, questionId])
  @@map("exam_answers")
}

model UserActivity {
  id        String   @id @default(uuid()) @map("id")
  userId    String   @map("user_id")
  date      DateTime @map("date")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("user_activities")
}