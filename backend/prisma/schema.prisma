generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  ADMIN

  @@map("user_role")
}

enum SubscriptionPlan {
  FREE
  PREMIUM

  @@map("subscription_plan")
}

model User {
  id               String           @id @default(uuid()) @map("id")
  fullName         String           @map("full_name")
  username         String           @unique @map("username")
  dateOfBirth      DateTime         @map("date_of_birth")
  email            String           @unique @map("email")
  passwordHash     String           @map("password_hash")
  subscriptionPlan SubscriptionPlan @default(FREE) @map("subscription_plan")
  role             UserRole         @default(STUDENT) @map("role")
  xp               Int              @default(0) @map("xp")
  streakCount      Int              @default(0) @map("streak_count")
  bestStreak       Int              @default(0) @map("best_streak")
  lastActiveAt     DateTime?        @map("last_active_at")
  avatarUrl        String?          @map("avatar_url")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  simulationAttempts SimulationAttempt[]
  userActivities UserActivity[]

  @@map("users")
}

enum ExamStatus {
  PUBLISHED
  DRAFT

  @@map("exam_status")
}

enum TopicStatus {
  PUBLISHED
  DRAFT

  @@map("topic_status")
}

enum ExamCategory {
  CONCURSOS
  CERTIFICACOES
  VESTIBULAR
  OAB
  OUTROS

  @@map("exam_category")
}

model Exam {
  id          String       @id @default(uuid()) @map("id")
  name        String       @map("name")
  slug        String       @unique @map("slug")
  description String?      @map("description")
  status      ExamStatus   @default(PUBLISHED) @map("status")
  order       Int          @default(0) @map("order")
  iconKey     String?      @map("icon_key")
  colorScheme String?      @map("color_scheme")
  category    ExamCategory @default(OUTROS) @map("category")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  topics Topic[]

  @@map("exams")
}

model Topic {
  id          String      @id @default(uuid()) @map("id")
  name        String      @map("name")
  slug        String      @map("slug")
  description String?     @map("description")
  status      TopicStatus @default(PUBLISHED) @map("status")
  showComingSoon Boolean  @default(false) @map("show_coming_soon")
  order       Int         @default(0) @map("order")
  examId      String      @map("exam_id")
  iconKey     String?     @map("icon_key")
  colorScheme String?     @map("color_scheme")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  exam   Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  simulations Simulation[]

  @@unique([examId, slug])
  @@map("topics")
}

enum SimulationStatus {
  PUBLISHED
  DRAFT

  @@map("simulation_status")
}

model Simulation {
  id                String           @id @default(uuid()) @map("id")
  name              String           @map("name")
  slug              String           @map("slug")
  description       String?          @map("description")
  order             Int              @map("order")
  topicId           String           @map("topic_id")
  status            SimulationStatus @default(PUBLISHED) @map("status")
  xpReward          Int              @default(0) @map("xp_reward")
  passingPercentage Float            @default(70.0) @map("passing_percentage")
  timeLimit         Int?             @map("time_limit")
  simulationMode    SimulationMode   @default(PRACTICE) @map("simulation_mode")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  topic              Topic               @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions          Question[]
  simulationAttempts SimulationAttempt[]

  @@unique([topicId, slug])
  @@map("simulations")
}

enum QuestionType {
  MULTIPLE_CHOICE
  SINGLE_CHOICE
  
  @@map("question_type")
}

enum QuestionStatus {
  PUBLISHED
  DRAFT

  @@map("question_status")
}

model Question {
  id          String         @id @default(uuid()) @map("id")
  content     String         @map("content")
  imageUrl    String?        @map("image_url")
  type        QuestionType   @default(MULTIPLE_CHOICE) @map("type")
  status      QuestionStatus @default(PUBLISHED) @map("status")
  order       Int            @map("order")
  explanation String?        @map("explanation")
  studyLink   String?        @map("study_link")
  simulationId String         @map("simulation_id")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  simulation   Simulation     @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  options      Option[]
  answers      AttemptAnswer[]

  @@map("questions")
}

model Option {
  id         String   @id @default(uuid()) @map("id")
  text       String   @map("text")
  isCorrect  Boolean  @default(false) @map("is_correct")
  order      Int      @map("order")
  questionId String   @map("question_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("options")
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED

  @@map("attempt_status")
}

enum SimulationMode {
  PRACTICE
  EXAM

  @@map("simulation_mode")
}

model SimulationAttempt {
  id             String        @id @default(uuid()) @map("id")
  userId         String        @map("user_id")
  simulationId   String        @map("simulation_id")
  status         AttemptStatus @default(IN_PROGRESS) @map("status")
  mode           SimulationMode @default(PRACTICE) @map("mode")
  score          Int?          @map("score")
  totalQuestions Int           @map("total_questions")
  percentage     Float?        @map("percentage")
  passed         Boolean?      @map("passed")
  stars          Int?          @map("stars")
  timeSpent      Int?          @map("time_spent")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  simulation Simulation  @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  answers AttemptAnswer[]

  @@map("simulation_attempts")
}

model AttemptAnswer {
  id                  String            @id @default(uuid()) @map("id")
  simulationAttemptId String            @map("simulation_attempt_id")
  questionId          String            @map("question_id")
  selectedOptions     String[]          @map("selected_options")
  isCorrect           Boolean?          @map("is_correct")
  timeSpent           Int?              @map("time_spent")
  isFlaggedForReview  Boolean           @default(false) @map("is_flagged_for_review")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  simulationAttempt   SimulationAttempt @relation(fields: [simulationAttemptId], references: [id], onDelete: Cascade)
  question            Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([simulationAttemptId, questionId])
  @@map("attempt_answers")
}

model UserActivity {
  id        String   @id @default(uuid()) @map("id")
  userId    String   @map("user_id")
  date      DateTime @map("date")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("user_activities")
}
