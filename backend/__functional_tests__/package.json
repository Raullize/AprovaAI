{
  "name": "aprovaai-functional-tests",
  "version": "1.0.0",
  "description": "Suite de testes funcionais para o AprovaAI",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "seed": "node seed.js",
    "rollback": "node rollback.js",
    "test": "node runFunctionalTests.js",
    "db:generate": "prisma generate --schema=../prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.5",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  },
  "jest": {
    "testEnvironment": "node",
    "verbose": true,
    "rootDir": ".",
    "testMatch": [
      "**/?(*.)+(test).js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/setup/setup.js"
    ]
  }
}
